Algoritmo CalcularAreaRectangulo
	
	Definir base, altura, resultado como Real
	
	Escribir "Ingrese la base del area a calcular"
	Leer  base
	Escribir "Ingrese la altura del area a calcular"
	Leer altura
	
//	resultado = base * altura
	
	Escribir "El area del rectamgulo es: ", base * altura
	
FinAlgoritmo
